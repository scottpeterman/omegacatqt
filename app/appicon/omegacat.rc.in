// app/appicon/omegacat.rc.in -- configured by app/CMakeLists.txt on Windows.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/appicon/omegacat.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OMEGACAT_RC_VERSION@
 PRODUCTVERSION @OMEGACAT_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Scott Peterman"
            VALUE "FileDescription", "OmegaCat"
            VALUE "FileVersion", "@OMEGACAT_NUMERIC_VERSION@"
            VALUE "InternalName", "omegacat"
            VALUE "LegalCopyright", "Copyright (C) 2026 Scott Peterman. GPL-3.0."
            VALUE "OriginalFilename", "omegacat.exe"
            VALUE "ProductName", "OmegaCat"
            VALUE "ProductVersion", "@OMEGACAT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
